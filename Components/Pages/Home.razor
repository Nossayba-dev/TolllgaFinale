@page "/pesee"
@using System.Globalization
@using TolllgaFinale.Services
@using TolllgaFinale.Models
@inject JsonSharingService JsonService
@inject DatabaseService    Db
@inject NavigationManager  Nav
@inject IPrintService PrintService
@inject PrinterSettingsService PrinterSettings
@implements IAsyncDisposable

<div class="page">

    @* ══ LIVE WEIGHT BANNER ══════════════════════════════════════════════════ *@
    <div class="weight-banner @(_flash ? "flash" : "")">
        <span class="weight-number">@DisplayWeight</span>
        <span class="weight-unit">kg</span>
        @if (_isPaused && _capturedWeight.HasValue)
        {
            <div class="captured-label">✅ Poids capturé : @_capturedWeight.Value.ToString("0.000") kg</div>
        }
    </div>

    @* ══ DIALOG: known truck with partial data ════════════════════════════════ *@
    @if (_dialog != DialogKind.None)
    {
        <div class="dialog-overlay">
            <div class="dialog">

                @if (_dialog == DialogKind.AskWeightType)
                {
                    <div class="dialog-title">🚛 Camion connu</div>
                    <p>Le camion <strong>@_matricule</strong> est déjà enregistré.</p>
                    @if (_knownTruck!.Tare > 0)
                    {
                        <p>Tare connue : <strong>@_knownTruck.Tare.ToString("0.000") kg</strong></p>
                    }
                    <p>Poids capturé : <strong>@_capturedWeight?.ToString("0.000") kg</strong></p>
                    <p>Cette pesée est-elle :</p>
                    <div class="dialog-actions">
                        <button class="btn-d-orange" @onclick='() => ResolveTypeDialog("brut")'>🏋 Poids Brut</button>
                        <button class="btn-d-gray"   @onclick='() => ResolveTypeDialog("tare")'>⚖ Tare</button>
                        <button class="btn-d-cancel" @onclick='() => ResolveTypeDialog("cancel")'>Annuler</button>
                    </div>
                }

                @if (_dialog == DialogKind.CompleteOtherWeight)
                {
                    <div class="dialog-title">⚖ Pesée incomplète trouvée</div>
                    <p>
                        Le camion <strong>@_matricule</strong> a déjà une pesée en cours :<br />
                        @if (_pendingRecord!.GrossWeight > 0 && _pendingRecord.Tare == 0)
                        {
                            <span>Poids Brut : <strong>@_pendingRecord.GrossWeight.ToString("0.000") kg</strong></span>
                            <br /><span>La <strong>Tare</strong> n'est pas encore enregistrée.</span>
                        }
                        else
                        {
                            <span>Tare : <strong>@_pendingRecord.Tare.ToString("0.000") kg</strong></span>
                            <br /><span>Le <strong>Poids Brut</strong> n'est pas encore enregistré.</span>
                        }
                    </p>
                    <p>Voulez-vous compléter cette pesée avec le poids capturé (<strong>@_capturedWeight?.ToString("0.000") kg</strong>) ?</p>
                    <div class="dialog-actions">
                        <button class="btn-d-green"  @onclick="CompleteExistingRecord">✅ Oui, compléter</button>
                        <button class="btn-d-orange" @onclick="StartNewRecord">➕ Non, nouvelle pesée</button>
                        <button class="btn-d-cancel" @onclick='() => ResolveTypeDialog("cancel")'>Annuler</button>
                    </div>
                }

            </div>
        </div>
    }

    <PrintOptionsDialog @bind-IsOpen="_printDialogOpen"
                         Ticket="_printTicket"
                         PrinterName="@PrinterSettings.GetDefaultPrinter()" />

    @* ══ TRUCK INFO ══════════════════════════════════════════════════════════ *@
    <div class="section">
        <div class="section-header">INFORMATIONS DU CAMION</div>
        <div class="section-body form-row">
            <div class="form-group">
                <label>Matricule Camion</label>
                <input type="text"
                       value="@_matricule"
                       disabled="@_isPaused"
                       @onchange="OnMatriculeChanged" />
            </div>
            <div class="form-group">
                <label>Nom Chauffeur (optionnel)</label>
                <input type="text" @bind="_chauffeur" disabled="@_isPaused" />
            </div>
        </div>
    </div>

    @* ══ TYPE + CLOCK ════════════════════════════════════════════════════════ *@
    <div class="row-panels">
        <div class="panel panel-left">
            <div class="panel-title">Type de Pesée</div>
            <label class="radio-label">
                <input type="radio" name="pesee" value="brut"
                       checked="@(_typePesee == "brut")"
                       disabled="@_isPaused"
                       @onchange="@(() => _typePesee = "brut")" />
                Poids Brut
            </label>
            <label class="radio-label">
                <input type="radio" name="pesee" value="tare"
                       checked="@(_typePesee == "tare")"
                       disabled="@_isPaused"
                       @onchange="@(() => _typePesee = "tare")" />
                Poids Tare
            </label>
        </div>

        <div class="panel panel-right">
            <div class="panel-title">Heure actuelle</div>
            <div class="clock">@_clock</div>
            <button class="btn-pause" @onclick="TogglePauseAsync">
                @(_isPaused ? "▶ Reprendre" : "⏸ Pause / Capturer Poids")
            </button>
        </div>
    </div>

    @* ══ RÉSUMÉ ══════════════════════════════════════════════════════════════ *@
    <div class="resume-title">Résumé des poids</div>
    <div class="resume-row">
        <div class="resume-card orange">
            <div class="resume-label">Poids Brut</div>
            <div class="resume-value">@(_poidsBrut?.ToString("000.000") ?? "000.000")</div>
        </div>
        <div class="resume-card gray">
            <div class="resume-label">Tare</div>
            <div class="resume-value">@(_poidsTare?.ToString("000.000") ?? "000.000")</div>
        </div>
        <div class="resume-card green">
            <div class="resume-label">Poids Net</div>
            <div class="resume-value">@PoidsNet</div>
        </div>
    </div>

    <div class="section">
        <div class="section-header">DÉTAILS DE LA PESÉE</div>
        <div class="section-body form-row">
            <div class="form-group">
                <label>Produit</label>
                <input type="text" @bind="_product" disabled="@_isPaused" />
            </div>
            <div class="form-group">
                <label>Observation</label>
                <input type="text" @bind="_observation" disabled="@_isPaused" />
            </div>
        </div>
        <div class="section-body form-row" style="padding-top:0">
            <div class="form-group" style="max-width:220px">
                <label>Amount</label>
                <input type="number"
                       min="0"
                       step="0.001"
                       inputmode="decimal"
                       @bind="_amountText"
                       disabled="@_isPaused" />
                <small style="color:#888;font-size:.78rem">Valeur numérique facultative ou obligatoire selon le processus métier.</small>
            </div>
        </div>
    </div>

    @* ══ ACTIONS ════════════════════════════════════════════════════════════ *@
    <div class="actions-row">
            <button class="btn-annuler" @onclick="Annuler">Annuler</button>
            <button class="btn-enregistrer" @onclick="EnregistrerAsync"
                    disabled="@(!CanSave)">
                Enregistrer
            </button>
            <button class="btn-imprimer" @onclick="SaveAndPrintAsync"
                    disabled="@(!CanSave)">
                💾🖨 Enregistrer et Imprimer
            </button>
        
    </div>

    

    @if (_isPaused && (_poidsBrut.HasValue ^ _poidsTare.HasValue))
    {
        <div class="hint-strip">
            💡 @(_poidsBrut.HasValue ? "Poids Brut capturé. Reprenez pour capturer la Tare." : "Tare capturée. Reprenez pour capturer le Poids Brut.")
            — Vous pouvez aussi <button class="btn-link" @onclick="EnregistrerAsync">enregistrer maintenant (partiel)</button>.
        </div>
    }

    @if (_saveSuccess)
    {
        <div class="success-strip">✅ Pesée enregistrée avec succès !</div>
    }
    @if (_error is not null)
    {
        <div class="error-strip">⚠ @_error</div>
    }

</div>

@code {
    // ── Scale ─────────────────────────────────────────────────────────────────
    private WeightData? _liveData;
    private string?     _error;
    private bool        _flash;

    // ── Pause / capture ───────────────────────────────────────────────────────
    private bool    _isPaused       = false;
    private double? _capturedWeight = null;

    private string DisplayWeight =>
        _isPaused && _capturedWeight.HasValue
            ? _capturedWeight.Value.ToString("000.000")
            : _liveData?.Weight.ToString("000.000") ?? "000.000";

    // ── Résumé ────────────────────────────────────────────────────────────────
    private double? _poidsBrut = null;
    private double? _poidsTare = null;

    private bool CanSave =>
        _isPaused && (_poidsBrut.HasValue || _poidsTare.HasValue);

    private string PoidsNet =>
        _poidsBrut.HasValue && _poidsTare.HasValue
            ? (_poidsBrut.Value - _poidsTare.Value).ToString("0.000")
            : "0.000";

    // ── Form ──────────────────────────────────────────────────────────────────
    private string _matricule = "";
    private string _chauffeur = "";
    private string _typePesee = "brut";
    private string _product = "";
    private string _observation = "";
    private string _amountText = "";

    // ── Dialog state ──────────────────────────────────────────────────────────
    private enum DialogKind { None, AskWeightType, CompleteOtherWeight }
    private DialogKind    _dialog        = DialogKind.None;
    private Truck?        _knownTruck    = null;
    private WeightRecord? _pendingRecord = null;

    // ── UI ────────────────────────────────────────────────────────────────────
    private bool   _saveSuccess = false;
    private string _clock       = DateTime.Now.ToString("HH:mm:ss");
    private string? _lastPdfPath = null;

    // ── Timers ────────────────────────────────────────────────────────────────
    private PeriodicTimer?          _pollTimer;
    private PeriodicTimer?          _clockTimer;
    private Task?                   _pollLoop;
    private Task?                   _clockLoop;
    private CancellationTokenSource _cts = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Db.InitAsync();
        await ReadOnce();
        StartTimers();
    }

    private Task OnMatriculeChanged(ChangeEventArgs e)
    {
        _matricule = e.Value?.ToString()?.ToUpper().Trim() ?? "";
        return Task.CompletedTask;
    }

    private static string? NormalizeText(string value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private bool TryParseAmount(out double amount)
    {
        var text = _amountText.Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            amount = 0;
            return true;
        }

        return (double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out amount)
                || double.TryParse(text.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out amount))
            && amount >= 0;
    }

    private void ResetDraftFields()
    {
        _product = "";
        _observation = "";
        _amountText = "";
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAUSE / RESUME
    // ══════════════════════════════════════════════════════════════════════════
    private async Task TogglePauseAsync()
    {
        if (!_isPaused)
        {
            if (_liveData is null) return;

            // ── PAUSE: freeze weight immediately ──────────────────────────────
            var captured = _liveData.Weight;   // snapshot before stopping timers
            _isPaused       = true;
            _capturedWeight = captured;
            StopTimers();

            System.Diagnostics.Debug.WriteLine($"[PAUSE] captured = {_capturedWeight}");

            if (string.IsNullOrWhiteSpace(_matricule))
            {
                AssignWeight(_typePesee);
                return;
            }

            _knownTruck = await Db.GetTruckByMatriculeAsync(_matricule);

            if (_knownTruck is not null)
            {
                _pendingRecord = await Db.GetPendingRecordAsync(_matricule);

                if (_pendingRecord is not null)
                {
                    _dialog = DialogKind.CompleteOtherWeight;
                    return;
                }

                _dialog = DialogKind.AskWeightType;
                return;
            }

            // New truck → assign directly from radio
            AssignWeight(_typePesee);
        }
        else
        {
            ResumeFromPause();
        }
    }

    private void ResolveTypeDialog(string choice)
    {
        _dialog = DialogKind.None;

        if (choice == "cancel")
        {
            ResumeFromPause();
            return;
        }

        _typePesee = choice;
        AssignWeight(choice);

        // Auto-fill the OTHER weight from truck data if available
        if (choice == "brut" && _knownTruck!.Tare > 0)
            _poidsTare = _knownTruck.Tare;
    }

    private void CompleteExistingRecord()
    {
        _dialog = DialogKind.None;

        if (_pendingRecord is null) return;

        if (_pendingRecord.GrossWeight > 0 && _pendingRecord.Tare == 0)
        {
            _poidsBrut = _pendingRecord.GrossWeight;
            _poidsTare = _capturedWeight;
            _typePesee = "tare";
        }
        else
        {
            _poidsTare = _pendingRecord.Tare;
            _poidsBrut = _capturedWeight;
            _typePesee = "brut";
        }
    }

    private void StartNewRecord()
    {
        _dialog        = DialogKind.None;
        _pendingRecord = null;
        AssignWeight(_typePesee);
    }

    private void AssignWeight(string type)
    {
        System.Diagnostics.Debug.WriteLine($"[AssignWeight] type={type} captured={_capturedWeight}");
        if (type == "brut") _poidsBrut = _capturedWeight;
        else                _poidsTare = _capturedWeight;
        System.Diagnostics.Debug.WriteLine($"[AssignWeight] poidsBrut={_poidsBrut} poidsTare={_poidsTare}");
    }

    private void ResumeFromPause()
    {
        _isPaused       = false;
        _capturedWeight = null;
        _poidsBrut      = null;
        _poidsTare      = null;
        _knownTruck     = null;
        _pendingRecord  = null;
        _dialog         = DialogKind.None;
        ResetDraftFields();
        StartTimers();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SAVE
    // ══════════════════════════════════════════════════════════════════════════
    private async Task<WeightRecord?> SaveRecordAsync()
    {
        if (!CanSave) return null;
        _error = null;
        _saveSuccess = false;

        if (!TryParseAmount(out var amount))
        {
            _error = "Amount invalide.";
            return null;
        }

        try
        {
            var product = NormalizeText(_product);
            var observation = NormalizeText(_observation);
            WeightRecord? saved;

            if (_pendingRecord is not null && _poidsBrut.HasValue && _poidsTare.HasValue)
            {
                saved = await Db.CompleteWeightRecordAsync(
                    _pendingRecord.Id,
                    _poidsBrut.Value,
                    _poidsTare.Value,
                    string.IsNullOrWhiteSpace(_chauffeur) ? null : _chauffeur,
                    product,
                    observation,
                    amount);
            }
            else
            {
                var record = new WeightRecord
                {
                    Matricule = _matricule,
                    DriverName = string.IsNullOrWhiteSpace(_chauffeur) ? null : _chauffeur,
                    Product = product,
                    Observation = observation,
                    Amount = amount,
                    GrossWeight = _poidsBrut ?? 0,
                    Tare = _poidsTare ?? 0,
                    NetWeight = (_poidsBrut ?? 0) - (_poidsTare ?? 0)
                };
                saved = await Db.SaveWeightRecordAsync(record);
            }

            _saveSuccess = true;
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _saveSuccess = false;
                InvokeAsync(StateHasChanged);
            });

            ResetFormAfterSave();
            return saved;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            System.Diagnostics.Debug.WriteLine($"[SAVE ERROR]: {ex}");
            return null;
        }
    }

    private async Task EnregistrerAsync() => await SaveRecordAsync();

    private TicketData? _printTicket;
    private bool _printDialogOpen;

    private async Task SaveAndPrintAsync()
    {
        var saved = await SaveRecordAsync();
        if (saved is null) return;

        var ticket = TicketData.FromRecord(saved);

        if (OperatingSystem.IsAndroid())
        {
            // Android n'a pas de "copies" natif dans PrintManager : on passe par le dialogue
            // personnalisé, qui transmet ensuite la valeur au service d'accessibilité.
            _printTicket = ticket;
            _printDialogOpen = true;
        }
        else
        {
            // Windows imprime déjà directement (sans boîte de dialogue) : pas besoin de ce dialogue.
            var printerName = PrinterSettings.GetDefaultPrinter();
            var ok = await PrintService.PrintTicketAsync(ticket, printerName);
            if (!ok) _error = "Impression échouée — vérifiez qu'une imprimante est configurée.";
        }
    }

    private void ResetFormAfterSave()
    {
        _isPaused = false;
        _capturedWeight = null;
        _poidsBrut = null;
        _poidsTare = null;
        _knownTruck = null;
        _pendingRecord = null;
        _dialog = DialogKind.None;
        _matricule = "";
        _chauffeur = "";
        _typePesee = "brut";
        ResetDraftFields();
        StartTimers();
    }
    

    private void NavigateToTickets() => Nav.NavigateTo("/tickets");

    private void Annuler()
    {
        _matricule      = "";
        _chauffeur      = "";
        _typePesee      = "brut";
        _poidsBrut      = null;
        _poidsTare      = null;
        _capturedWeight = null;
        _knownTruck     = null;
        _pendingRecord  = null;
        _dialog         = DialogKind.None;
        _saveSuccess    = false;
        _error          = null;
        ResetDraftFields();

        if (_isPaused)
        {
            _isPaused = false;
            StartTimers();
        }
    }

    // ── Timers ────────────────────────────────────────────────────────────────
    private void StartTimers()
    {
        if (_pollTimer is not null) return;
        _cts        = new CancellationTokenSource();
        _pollTimer  = new PeriodicTimer(TimeSpan.FromMilliseconds(300));
        _clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _pollLoop   = PollLoop(_cts.Token);
        _clockLoop  = ClockLoop(_cts.Token);
    }

    private void StopTimers()
    {
        _cts.Cancel();
        _pollTimer?.Dispose();  _pollTimer  = null;
        _clockTimer?.Dispose(); _clockTimer = null;
    }

    private async Task PollLoop(CancellationToken ct)
    {
        var timer = _pollTimer;
        if (timer is null) return;
        try
        {
            while (!ct.IsCancellationRequested && await timer.WaitForNextTickAsync(ct))
            {
                await ReadOnce();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException)    { }
    }

    private async Task ClockLoop(CancellationToken ct)
    {
        var timer = _clockTimer;
        if (timer is null) return;
        try
        {
            while (!ct.IsCancellationRequested && await timer.WaitForNextTickAsync(ct))
            {
                _clock = DateTime.Now.ToString("HH:mm:ss");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException)    { }
    }

    private async Task ReadOnce()
    {
        try
        {
            var prev = _liveData?.Weight;
            var data = await JsonService.ReadWeightAsync();

            // Lecture directe : si le fichier n'existe pas encore ou n'est pas
            // lisible, on garde simplement la dernière valeur connue (ou 0 au
            // départ). Aucune vérification de l'état de l'App 1.
            if (data is not null)
            {
                _liveData = data;

                if (_liveData.Weight != prev)
                {
                    _flash = true;
                    _ = Task.Delay(200).ContinueWith(_ =>
                    {
                        _flash = false;
                        InvokeAsync(StateHasChanged);
                    });
                }
            }
        }
        catch
        {
            // Lecture silencieuse : on ignore l'erreur et on retente au prochain tick.
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopTimers();
        try
        {
            if (_pollLoop  is not null) await _pollLoop.ConfigureAwait(false);
            if (_clockLoop is not null) await _clockLoop.ConfigureAwait(false);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException)    { }
    }
}

<style>
    .page {
        max-width: 780px; margin: 0 auto; padding: 1rem;
        font-family: 'Segoe UI', sans-serif; background: #f0f0f0; min-height: 100vh;
    }

    .weight-banner {
        background: #fff; border-radius: 10px; text-align: center;
        padding: 1.2rem 1rem; margin-bottom: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        transition: box-shadow .15s, transform .15s;
    }
    .weight-banner.flash { transform: scale(1.01); box-shadow: 0 0 18px rgba(30,100,30,.3); }
    .weight-number { font-size: 3.8rem; font-weight: 700; color: #1b3a1b; font-variant-numeric: tabular-nums; letter-spacing: -1px; }
    .weight-unit   { font-size: 1.8rem; color: #1b3a1b; margin-left: .4rem; }
    .captured-label { font-size: .85rem; color: #2d5a27; font-weight: 700; margin-top: .3rem; }

    .dialog-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.5);
        display: flex; align-items: center; justify-content: center; z-index: 999;
    }
    .dialog {
        background: #fff; border-radius: 14px; padding: 2rem 1.8rem;
        max-width: 440px; width: 92%; box-shadow: 0 8px 32px rgba(0,0,0,.22); text-align: center;
    }
    .dialog-title { font-size: 1.15rem; font-weight: 700; color: #2d5a1b; margin-bottom: .8rem; }
    .dialog p { font-size: .9rem; color: #333; margin-bottom: .5rem; line-height: 1.5; }
    .dialog-actions { display: flex; flex-direction: column; gap: .55rem; margin-top: 1.1rem; }
    .btn-d-green  { background: #2d5a1b; color: #fff; border: none; border-radius: 8px; padding: .65rem 1rem; font-size: .93rem; cursor: pointer; font-weight: 600; }
    .btn-d-orange { background: #e07b30; color: #fff; border: none; border-radius: 8px; padding: .65rem 1rem; font-size: .93rem; cursor: pointer; font-weight: 600; }
    .btn-d-gray   { background: #777;    color: #fff; border: none; border-radius: 8px; padding: .65rem 1rem; font-size: .93rem; cursor: pointer; font-weight: 600; }
    .btn-d-cancel { background: #f0f0f0; color: #555; border: none; border-radius: 8px; padding: .5rem 1rem; font-size: .85rem; cursor: pointer; }

    .section { background: #fff; border-radius: 10px; margin-bottom: 1rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.07); }
    .section-header { background: #2d5a1b; color: #fff; font-weight: 700; font-size: .95rem; letter-spacing: .06em; padding: .7rem 1.2rem; }
    .section-body { padding: 1rem 1.2rem; }
    .form-row { display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .form-group { flex: 1; min-width: 180px; display: flex; flex-direction: column; gap: .3rem; }
    .form-group label { font-size: .85rem; color: #333; }
    .form-group input[type=text], .form-group input[type=number] { border: 1px solid #ccc; border-radius: 5px; padding: .45rem .7rem; font-size: .95rem; outline: none; width: 100%; }
    .form-group input[type=text]:focus, .form-group input[type=number]:focus { border-color: #2d5a1b; }
    .form-group input[type=text]:disabled, .form-group input[type=number]:disabled { background: #f5f5f5; color: #999; cursor: not-allowed; }

    .row-panels { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .panel { background: #fff; border-radius: 10px; padding: 1rem 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,.07); flex: 1; min-width: 200px; }
    .panel-title { font-weight: 700; font-size: .9rem; color: #222; margin-bottom: .6rem; }
    .radio-label { display: flex; align-items: center; gap: .4rem; font-size: .9rem; color: #333; margin-bottom: .3rem; cursor: pointer; }
