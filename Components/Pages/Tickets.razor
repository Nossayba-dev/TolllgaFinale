@page "/tickets"
@layout Layout.MainLayout
@using TolllgaFinale.Models
@using TolllgaFinale.Services
@using System.IO
@inject DatabaseService Db
@inject NavigationManager Nav
@inject IInvoiceService InvoiceService

<div class="page-title">? Tickets</div>

<div class="card-white">
    @if (_tickets is null)
    {
        <p style="color:#999;text-align:center;padding:2rem">Chargement…</p>
    }
    else if (_tickets.Count == 0)
    {
        <p style="color:#999;text-align:center;padding:2rem">Aucun ticket trouvé.</p>
    }
    else
    {
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem">
            <div></div>
            <div>
                <button class="btn-small" @onclick="Refresh">Rafraîchir</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-strip" style="margin-bottom:0.6rem">? @_errorMessage</div>
        }

        <table class="tbl">
            <thead>
                <tr>
                    <th>Ticket #</th>
                    <th>Matricule</th>
                    <th>Chauffeur</th>
                    <th>Opérateur tare</th>
                    <th>Opérateur brut</th>
                    <th>Date</th>
                    <th style="text-align:right">Net (kg)</th>
                    <th>PDF</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tickets)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td class="bold">@t.Matricule</td>
                        <td>@(t.DriverName ?? "—")</td>
                        <td>@t.OperatorTare.GetOperatorLabel()</td>
                        <td>@t.OperatorGross.GetOperatorLabel()</td>
                        <td>@FormatDate(t.GetLatestWeighingDate())</td>
                        <td style="text-align:right">@t.NetWeight.ToString("N3")</td>
                        <td>
                            <button class="btn-small" @onclick="() => OpenPdfAsync(t)">Générer / Ouvrir PDF</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<WeightRecord>? _tickets;
    private string? _lastPdfPath;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Db.InitAsync();
        await LoadTicketsAsync();
    }

    private Task Refresh() => LoadTicketsAsync();

    private async Task LoadTicketsAsync()
    {
        _errorMessage = null;
        _tickets = await Db.GetAllWeightsAsync();
        StateHasChanged();
    }

    private static string FormatDate(DateTime value)
        => value == default ? "—" : value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private async Task OpenPdfAsync(WeightRecord record)
    {
        _errorMessage = null;
        _lastPdfPath = null;

        if (record is null) return;

        var rec = await Db.GetWeightRecordByIdAsync(record.Id) ?? record;

        try
        {
            var path = await InvoiceService.GeneratePdfAsync(rec);
            _lastPdfPath = path;

            if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
            {
                _errorMessage = "Le fichier PDF n'a pas été trouvé après génération.";
                return;
            }

            await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(new Microsoft.Maui.ApplicationModel.OpenFileRequest("Ticket", new Microsoft.Maui.Storage.ReadOnlyFile(path)));
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            System.Diagnostics.Debug.WriteLine($"[OpenPdfAsync] Error: {ex}");
        }
        finally
        {
            await LoadTicketsAsync();
            StateHasChanged();
        }
    }
}
