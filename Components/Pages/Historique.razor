@page "/historique"
@layout WeightSyncFinale.Components.Layout.MainLayout
@using TolllgaFinale.Models
@using TolllgaFinale.Services
@inject DatabaseService Db

<div class="page-title">📋 Historique des Pesées</div>

@* ── Filters ── *@
<div class="card-white filter-bar">
    <div class="form-group">
        <label>Matricule</label>
        <input type="text" @bind="_filterMatricule" placeholder="Tous" />
    </div>
    <div class="form-group">
        <label>Date début</label>
        <input type="date" @bind="_filterFrom" />
    </div>
    <div class="form-group">
        <label>Date fin</label>
        <input type="date" @bind="_filterTo" />
    </div>
    <div class="form-group" style="display:flex;align-items:flex-end;gap:.5rem">
        <button class="btn-green" @onclick="ApplyFilter">🔍 Filtrer</button>
        <button class="btn-gray"  @onclick="ResetFilter">✕ Reset</button>
    </div>
</div>

@* ── Summary strip ── *@
@if (_filtered is not null && _filtered.Count > 0)
{
    <div class="summary-strip">
        <span><strong>@_filtered.Count</strong> pesée(s)</span>
        <span>Poids Net Total : <strong>@_filtered.Sum(w => w.NetWeight).ToString("N0") kg</strong></span>
    </div>
}

@* ── Table ── *@
<div class="card-white">
    @if (_filtered is null)
    {
        <p style="color:#999;text-align:center;padding:2rem">Chargement…</p>
    }
    else if (_filtered.Count == 0)
    {
        <p style="color:#999;text-align:center;padding:2rem">Aucune pesée trouvée.</p>
    }
    else
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Matricule</th>
                    <th>Chauffeur</th>
                    <th style="text-align:right">Poids Brut (kg)</th>
                    <th style="text-align:right">Tare (kg)</th>
                    <th style="text-align:right">Poids Net (kg)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in _filtered)
                {
                    <tr>
                        <td>@w.WeighingDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="bold">@w.Matricule</td>
                        <td>@(w.DriverName ?? "—")</td>
                        <td style="text-align:right">@w.GrossWeight.ToString("N0")</td>
                        <td style="text-align:right">@w.Tare.ToString("N0")</td>
                        <td style="text-align:right" class="green">@w.NetWeight.ToString("N0")</td>
                        <td>
                            <button class="btn-red btn-sm" @onclick="() => DeleteAsync(w)">🗑</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── Delete confirm dialog ── *@
@if (_deleteTarget is not null)
{
    <div class="dialog-overlay">
        <div class="dialog">
            <div class="dialog-title">Confirmer la suppression</div>
            <p>Supprimer la pesée du <strong>@_deleteTarget.WeighingDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> pour <strong>@_deleteTarget.Matricule</strong> ?</p>
            <div class="dialog-actions">
                <button class="btn-red"  @onclick="ConfirmDeleteAsync">Supprimer</button>
                <button class="btn-gray" @onclick="() => _deleteTarget = null">Annuler</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WeightRecord>? _all;
    private List<WeightRecord>? _filtered;

    private string   _filterMatricule = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    private WeightRecord? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await Db.InitAsync();
        _all = await Db.GetAllWeightsAsync();
        _filtered = _all;
    }

    private void ApplyFilter()
    {
        if (_all is null) return;
        _filtered = _all.Where(w =>
        {
            if (!string.IsNullOrWhiteSpace(_filterMatricule) &&
                !w.Matricule.Contains(_filterMatricule, StringComparison.OrdinalIgnoreCase))
                return false;
            var local = w.WeighingDate.ToLocalTime();
            if (_filterFrom.HasValue && local.Date < _filterFrom.Value.Date) return false;
            if (_filterTo.HasValue   && local.Date > _filterTo.Value.Date)   return false;
            return true;
        }).ToList();
    }

    private async Task ResetFilter()
    {
        _filterMatricule = ""; _filterFrom = null; _filterTo = null;
        _all = await Db.GetAllWeightsAsync();
        _filtered = _all;
    }

    private void DeleteAsync(WeightRecord w) => _deleteTarget = w;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;
        await Db.DeleteWeightRecordAsync(_deleteTarget.Id);
        _deleteTarget = null;
        _all = await Db.GetAllWeightsAsync();
        ApplyFilter();
    }
}

<style>
    .filter-bar { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end; }
    .filter-bar .form-group { flex: 1; min-width: 140px; display: flex; flex-direction: column; gap: .3rem; }
    .filter-bar label { font-size: .82rem; color: #555; }

    .summary-strip {
        background: #f0f8ee;
        border: 1px solid #c5e1a5;
        border-radius: 8px;
        padding: .6rem 1.2rem;
        margin-bottom: 1rem;
        display: flex;
        gap: 2rem;
        font-size: .88rem;
        color: #2d5a27;
    }

    .btn-sm { padding: .25rem .55rem; font-size: .8rem; }

    .dialog-overlay {
        position: fixed; inset: 0;
        background: rgba(0,0,0,.45);
        display: flex; align-items: center; justify-content: center;
        z-index: 1000;
    }
    .dialog {
        background: #fff; border-radius: 12px; padding: 2rem 1.8rem;
        max-width: 380px; width: 90%; box-shadow: 0 8px 32px rgba(0,0,0,.2);
        text-align: center;
    }
    .dialog-title { font-size: 1.1rem; font-weight: 700; color: #c0392b; margin-bottom: .8rem; }
    .dialog p { font-size: .9rem; color: #333; margin-bottom: 1rem; }
    .dialog-actions { display: flex; gap: .6rem; justify-content: center; }
</style>
